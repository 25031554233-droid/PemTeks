    "Tipe N-Gram": ["Unigram" if len(f.split()) == 1 else ("Bigram" if len(f.split()) == 2 else "Trigram") for f in bow_feature_names],
    "Total Frekuensi Kemunculan (TF)": bow_matrix.sum(axis=0).A1,
