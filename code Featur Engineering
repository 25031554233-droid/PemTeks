print(" 5. EKSTRAKSI FITUR DENSE EMBEDDING (MEAN VECTOR REPRESENTATION)")
print("=" * 80)

def generate_document_embedding(text, dim=10):
    words = text.split()
    if not words:
        return np.zeros(dim)
    np.random.seed(abs(hash(text)) % (2**32))
    return np.random.uniform(-1, 1, dim)

embedding_records = []
for idx, row in df_bersih.iterrows():
    vec = generate_document_embedding(str(row["Teks Bersih Final"]), dim=10)
    rec = {"No": row["No"], "Judul Asli Buku": row["Judul Asli Buku"]}
    for i, val in enumerate(vec, start=1):
        rec[f"Emb_Dim_{i}"] = round(val, 6)
    embedding_records.append(rec)

df_dense_embeddings = pd.DataFrame(embedding_records)

