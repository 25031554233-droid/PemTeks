def calculate_entropy(text):
    tokens = text.split()
    if not tokens:
        return 0.0
    freq = pd.Series(tokens).value_counts() / len(tokens)
    return -sum(freq * np.log2(freq))

meta_records = []
for idx, row in df_bersih.iterrows():
    raw_title = str(row["Judul Asli Buku"])
    clean_text = str(row["Teks Bersih Final"])
    tokens = clean_text.split() if clean_text else []

    char_count_raw = len(raw_title)
    char_count_clean = len(clean_text)
    word_count_clean = len(tokens)
    unique_word_count = len(set(tokens))
    avg_word_length = np.mean([len(w) for w in tokens]) if tokens else 0
    ttr = (unique_word_count / word_count_clean) if word_count_clean > 0 else 0
    entropy = calculate_entropy(clean_text)

    meta_records.append({
        "No": row["No"],
        "Judul Asli Buku": raw_title,
        "Panjang Karakter Mentah": char_count_raw,
        "Panjang Karakter Bersih": char_count_clean,
        "Jumlah Kata (Word Count)": word_count_clean,
        "Kata Unik (Unique Words)": unique_word_count,
        "Rata-Rata Panjang Kata": round(avg_word_length, 2),
        "Rasio Variasi Kosakata (TTR)": round(ttr, 4),
        "Entropi Informasi Teks": round(entropy, 4)
    })

df_meta_features = pd.DataFrame(meta_records)
print(df_meta_features.head(10))

