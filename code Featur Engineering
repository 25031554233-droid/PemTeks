    "No": df_bersih["No"],
    "Judul Asli Buku": df_bersih["Judul Asli Buku"],
    "Teks Bersih Final": df_bersih["Teks Bersih Final"],
    "ID Klaster Topik": cluster_labels,
    "Label Kategori Topik": [f"Sub-Topik Klaster {lbl+1}" for lbl in cluster_labels]
})

