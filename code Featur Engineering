    "Rata-Rata Bobot TF-IDF": tfidf_matrix.mean(axis=0).A1,
    "Maksimum Bobot TF-IDF": tfidf_matrix.max(axis=0).toarray().flatten(),
    "Document Frequency (DF)": (tfidf_matrix > 0).sum(axis=0).A1
}).sort_values(by="Rata-Rata Bobot TF-IDF", ascending=False).reset_index(drop=True)

# Klasterisasi Topik Otomatis (4 Cluster Topik)
